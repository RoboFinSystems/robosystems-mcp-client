{
  "name": "@robosystems/mcp",
  "version": "1.1.0",
  "description": "MCP stdio bridge for RoboSystems, the open-source knowledge graph for finance; one connection for every graph an API key reaches",
  "mcpName": "ai.robosystems/mcp-bridge",
  "type": "module",
  "main": "index.js",
  "bin": {
    "@robosystems/mcp": "./index.js"
  },
  "files": [
    "index.js",
    "proxy.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:fix": "npm run format && npm run lint:fix",
    "validate": "npm run validate:fix && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run validate && npm run test",
    "feature:create": "./bin/create-feature.sh",
    "release:create": "./bin/create-release.sh"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "robosystems",
    "knowledge-graph",
    "accounting",
    "general-ledger",
    "sec",
    "xbrl",
    "financial-data"
  ],
  "author": "RFS LLC",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.0.0",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RoboFinSystems/robosystems-mcp-bridge"
  },
  "bugs": {
    "url": "https://github.com/RoboFinSystems/robosystems-mcp-bridge/issues"
  },
  "homepage": "https://robosystems.ai/docs/technical/the-mcp-bridge"
}
